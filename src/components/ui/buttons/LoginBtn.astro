---
const { title = 'Log in' } = Astro.props;

interface Props {
  title?: string;
}

const baseClasses =
  'flex items-center gap-x-2 text-base md:text-sm font-medium text-white/90 ring-white/40 transition duration-300 focus-visible:ring-3 outline-hidden';
const hoverClasses = 'hover:text-yellow-300';
const mdClasses = 'md:my-6 md:border-s md:border-white/20 md:ps-6';
const txtSizeClasses = '2xl:text-base';
const userSVG = `<svg
      class="h-4 w-4 shrink-0"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
  >
    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
    <circle cx="12" cy="7" r="4"></circle>
  </svg>`;
---

<button
  type="button"
  class={`${baseClasses} ${hoverClasses} ${mdClasses} ${txtSizeClasses}`}
  data-hs-overlay="#hs-toggle-between-modals-login-modal"
>
  {
    /* About Fragment: https://docs.astro.build/en/basics/astro-syntax/#fragments */
  }

  <Fragment set:html={userSVG} />
  {title}
</button>
