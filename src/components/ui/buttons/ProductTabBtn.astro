---
const { id, dataTab, title, first } = Astro.props;

interface Props {
  id: string;
  dataTab: string;
  title: string;
  first?: boolean;
}

interface TabContent {
  label: string;
  subtitle: string;
}

const TAB_CONTENT: Record<string, TabContent> = {
  Description: {
    label: 'Giới thiệu',
    subtitle: 'Về món này',
  },
  Specifications: {
    label: 'Thông tin',
    subtitle: 'Size & thành phần',
  },
  Blueprints: {
    label: 'Hình ảnh',
    subtitle: 'Gallery món',
  },
  Spécifications: {
    label: 'Thông tin',
    subtitle: 'Size & thành phần',
  },
  Plans: {
    label: 'Hình ảnh',
    subtitle: 'Gallery món',
  },
};

const tab = TAB_CONTENT[title] ?? { label: title, subtitle: '' };

const BUTTON_CLASS =
  'product-tab-btn flex w-full flex-col items-center justify-center gap-0.5 rounded-xl border border-transparent p-3 text-center outline-hidden ring-[#006D3A]/30 transition duration-300 hover:bg-[#006D3A]/5 focus-visible:ring-3 md:p-5';

const isActive = first;
---

<button
  type="button"
  class:list={[BUTTON_CLASS, { active: isActive, 'bg-[#006D3A]/10': isActive }]}
  id={id}
  data-target={dataTab}
  role="tab"
  aria-selected={isActive ? 'true' : 'false'}
>
  <span
    class:list={[
      'tab-title block text-sm font-bold md:text-base',
      isActive
        ? 'text-[#006D3A] dark:text-green-400'
        : 'text-neutral-800 dark:text-neutral-200',
    ]}
  >
    {tab.label}
  </span>
  {
    tab.subtitle && (
      <span class="tab-subtitle block text-xs font-medium text-neutral-500 opacity-80 dark:text-neutral-400">
        {tab.subtitle}
      </span>
    )
  }
</button>
