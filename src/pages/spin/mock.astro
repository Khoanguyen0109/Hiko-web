---
/**
 * Mock spin game — preview only, no backend.
 * Open: npm run dev → http://localhost:4321/spin/mock
 */
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Vòng Quay May Mắn | Hiko Matcha (Mock)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --matcha: #b9d77a;
        --matcha-dark: #016d3b;
        --matcha-deep: #014a29;
        --cream: #fff8e8;
        --beige: #f5e7cf;
        --gold: #d7b75a;
        --text: #1f2d24;
        --text-muted: #5d6b63;
        --white: #ffffff;
        --shadow: 0 24px 60px rgba(1, 77, 41, 0.14);
        --radius: 1.25rem;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "DM Sans", system-ui, sans-serif;
        background: linear-gradient(165deg, var(--cream) 0%, #edf8f2 45%, var(--beige) 100%);
        color: var(--text);
        min-height: 100dvh;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 28rem;
        margin: 0 auto;
        min-height: 100dvh;
        padding: 1rem 1rem 2rem;
        display: flex;
        flex-direction: column;
      }

      .badge {
        align-self: center;
        margin-top: 0.5rem;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        background: rgba(1, 109, 59, 0.08);
        color: var(--matcha-dark);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .header {
        text-align: center;
        padding: 1.25rem 0 1rem;
      }

      .logo {
        width: 3.5rem;
        height: 3.5rem;
        margin: 0 auto 0.75rem;
        border-radius: 50%;
        background: linear-gradient(145deg, var(--matcha) 0%, var(--matcha-dark) 100%);
        display: grid;
        place-items: center;
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        box-shadow: 0 8px 24px rgba(1, 109, 59, 0.25);
      }

      h1 {
        font-size: 1.65rem;
        line-height: 1.15;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .subtitle {
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.45;
      }

      .card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        border: 1px solid rgba(1, 109, 59, 0.08);
        padding: 1.25rem;
      }

      .screen {
        display: none;
        flex-direction: column;
        gap: 1rem;
        animation: fadeUp 0.45s ease;
      }

      .screen.active {
        display: flex;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(12px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 0.4rem;
      }

      .phone-row {
        display: flex;
        gap: 0.5rem;
      }

      .prefix {
        display: grid;
        place-items: center;
        padding: 0 0.85rem;
        border-radius: 0.85rem;
        background: #edf8f2;
        color: var(--matcha-dark);
        font-weight: 600;
        font-size: 0.95rem;
        border: 1px solid rgba(1, 109, 59, 0.12);
      }

      input[type="tel"] {
        flex: 1;
        border: 1px solid rgba(1, 109, 59, 0.15);
        border-radius: 0.85rem;
        padding: 0.85rem 1rem;
        font-size: 1.05rem;
        font-family: inherit;
        letter-spacing: 0.06em;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      input[type="tel"]:focus {
        border-color: var(--matcha-dark);
        box-shadow: 0 0 0 3px rgba(185, 215, 122, 0.35);
      }

      .hint {
        font-size: 0.78rem;
        color: var(--text-muted);
        line-height: 1.4;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        width: 100%;
        border: none;
        border-radius: 999px;
        padding: 0.95rem 1.25rem;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
      }

      .btn:active:not(:disabled) {
        transform: scale(0.98);
      }

      .btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--matcha-dark) 0%, var(--matcha-deep) 100%);
        color: white;
        box-shadow: 0 10px 28px rgba(1, 109, 59, 0.28);
      }

      .btn-secondary {
        background: transparent;
        color: var(--matcha-dark);
        border: 1.5px solid rgba(1, 109, 59, 0.25);
      }

      .btn-row {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      /* Wheel */
      .wheel-wrap {
        position: relative;
        width: min(100%, 20rem);
        margin: 0.5rem auto 0;
        aspect-ratio: 1;
      }

      .wheel-pointer {
        position: absolute;
        top: -0.35rem;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 14px solid transparent;
        border-right: 14px solid transparent;
        border-top: 28px solid var(--matcha-dark);
        z-index: 3;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
      }

      .wheel-ring {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        background: linear-gradient(145deg, var(--gold) 0%, #c4a24a 100%);
        box-shadow: 0 12px 40px rgba(1, 77, 41, 0.2);
      }

      .wheel {
        position: absolute;
        inset: 6px;
        border-radius: 50%;
        overflow: visible;
        transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
        will-change: transform;
      }

      .wheel-center {
        position: absolute;
        inset: 50%;
        transform: translate(-50%, -50%);
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 50%;
        background: var(--white);
        border: 3px solid var(--gold);
        z-index: 2;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: 0.62rem;
        color: var(--matcha-dark);
        text-align: center;
        line-height: 1.05;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      }

      .wheel svg {
        width: 100%;
        height: 100%;
        overflow: visible;
      }

      .wheel-segment {
        stroke: rgba(255, 255, 255, 0.35);
        stroke-width: 2;
      }

      .wheel-icon {
        font-family: "DM Sans", system-ui, sans-serif;
        font-size: 11px;
        text-anchor: middle;
        dominant-baseline: central;
      }

      .wheel-label-sub {
        font-family: "DM Sans", system-ui, sans-serif;
        font-size: 4.5px;
        font-weight: 600;
        text-anchor: middle;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .wheel-label-main {
        font-family: "DM Sans", system-ui, sans-serif;
        font-size: 6.5px;
        font-weight: 800;
        text-anchor: middle;
        letter-spacing: 0.01em;
      }

      .wheel-label-single {
        font-family: "DM Sans", system-ui, sans-serif;
        font-size: 5.5px;
        font-weight: 700;
        text-anchor: middle;
        letter-spacing: 0.02em;
      }

      .wheel-label-bg {
        stroke-width: 0.4;
      }

      /* Result */
      .result-icon {
        width: 4.5rem;
        height: 4.5rem;
        margin: 0 auto;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-size: 2rem;
      }

      .result-icon.win {
        background: linear-gradient(145deg, #d7f0e2, #b2e0c5);
      }

      .result-icon.lose {
        background: linear-gradient(145deg, #f5e7cf, #ede0c8);
      }

      .result-title {
        text-align: center;
        font-size: 1.45rem;
        font-weight: 700;
      }

      .result-prize {
        text-align: center;
        font-size: 1.1rem;
        color: var(--matcha-dark);
        font-weight: 600;
      }

      .voucher-box {
        background: linear-gradient(180deg, #f8fcf9 0%, var(--cream) 100%);
        border: 1.5px dashed rgba(1, 109, 59, 0.25);
        border-radius: 1rem;
        padding: 1rem;
        text-align: center;
      }

      .voucher-code {
        font-family: ui-monospace, monospace;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        color: var(--matcha-dark);
      }

      .qr-placeholder {
        width: 9rem;
        height: 9rem;
        margin: 1rem auto 0.5rem;
        background: white;
        border-radius: 0.75rem;
        border: 1px solid rgba(1, 109, 59, 0.12);
        display: grid;
        place-items: center;
        position: relative;
        overflow: hidden;
      }

      .qr-grid {
        width: 7rem;
        height: 7rem;
        background-image:
          linear-gradient(90deg, #1f2d24 1px, transparent 1px),
          linear-gradient(#1f2d24 1px, transparent 1px);
        background-size: 8px 8px;
        opacity: 0.85;
        border-radius: 4px;
      }

      .qr-label {
        position: absolute;
        bottom: 0.35rem;
        font-size: 0.62rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
      }

      .staff-note {
        font-size: 0.82rem;
        color: var(--text-muted);
        text-align: center;
        line-height: 1.45;
        padding: 0 0.5rem;
      }

      .mock-banner {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(31, 45, 36, 0.92);
        color: #edf8f2;
        text-align: center;
        padding: 0.55rem 1rem;
        font-size: 0.75rem;
        z-index: 50;
        backdrop-filter: blur(8px);
      }

      .mock-banner strong {
        color: var(--matcha);
      }

      .state-tabs {
        display: flex;
        gap: 0.35rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-bottom: 0.5rem;
      }

      .state-tab {
        border: 1px solid rgba(1, 109, 59, 0.2);
        background: rgba(255, 255, 255, 0.7);
        color: var(--matcha-dark);
        border-radius: 999px;
        padding: 0.3rem 0.65rem;
        font-size: 0.68rem;
        font-weight: 600;
        cursor: pointer;
      }

      .state-tab.active {
        background: var(--matcha-dark);
        color: white;
        border-color: var(--matcha-dark);
      }
    </style>
  </head>
  <body>
    <div class="page">
      <span class="badge">Mock Preview</span>

      <header class="header">
        <div class="logo">HK</div>
        <h1>Vòng Quay May Mắn</h1>
        <p class="subtitle">Nhập số điện thoại để quay và nhận ưu đãi Hiko Matcha</p>
      </header>

      <!-- Demo: jump between states -->
      <div class="state-tabs" aria-hidden="true">
        <button class="state-tab active" data-goto="phone">Phone</button>
        <button class="state-tab" data-goto="wheel">Wheel</button>
        <button class="state-tab" data-goto="win">Win</button>
        <button class="state-tab" data-goto="lose">Lose</button>
      </div>

      <!-- Screen 1: Phone -->
      <section id="screen-phone" class="screen active card">
        <div>
          <label for="phone">Số điện thoại</label>
          <div class="phone-row">
            <span class="prefix">+84</span>
            <input
              id="phone"
              type="tel"
              inputmode="numeric"
              maxlength="10"
              placeholder="912345678"
              value="912345678"
            />
          </div>
          <p class="hint" style="margin-top: 0.5rem">Mỗi số chỉ được quay 1 lần trong chiến dịch này.</p>
        </div>
        <div class="btn-row">
          <button id="btn-spin" class="btn btn-primary">Quay Ngay</button>
          <button id="btn-lookup" class="btn btn-secondary">Xem Voucher Của Tôi</button>
          <a href="/" class="btn btn-secondary">Vô Hiko nè!</a>
        </div>
      </section>

      <!-- Screen 2: Wheel -->
      <section id="screen-wheel" class="screen card">
        <p class="hint" style="text-align: center">Đang quay… Chúc bạn may mắn!</p>
        <div class="wheel-wrap">
          <div class="wheel-pointer" aria-hidden="true"></div>
          <div class="wheel-ring" aria-hidden="true"></div>
          <div id="wheel" class="wheel" role="img" aria-label="Vòng quay may mắn">
            <svg id="wheel-svg" viewBox="-100 -100 200 200"></svg>
          </div>
          <div class="wheel-center">HIKO<br />MATCHA</div>
        </div>
      </section>

      <!-- Screen 3: Win -->
      <section id="screen-win" class="screen card">
        <div class="result-icon win">🎉</div>
        <h2 class="result-title">Chúc mừng!</h2>
        <p class="result-prize">Bạn nhận được: Giảm 10% 🏷️</p>
        <div class="voucher-box">
          <p class="hint">Mã voucher</p>
          <p class="voucher-code">HK-A3X9K2</p>
          <div class="qr-placeholder">
            <div class="qr-grid" aria-hidden="true"></div>
            <span class="qr-label">QR mock — staff scan at POS</span>
          </div>
        </div>
        <p class="staff-note">Đưa màn hình này cho nhân viên quét QR tại quầy. Mỗi mã chỉ dùng 1 lần.</p>
        <div class="btn-row">
          <button class="btn btn-secondary" data-goto="phone">Quay lại</button>
          <a href="/" class="btn btn-secondary">Vô Hiko nè!</a>
        </div>
      </section>

      <!-- Screen 4: Lose -->
      <section id="screen-lose" class="screen card">
        <div class="result-icon lose">🍃</div>
        <h2 class="result-title">Chưa trúng lần này</h2>
        <p class="staff-note" style="margin-top: 0.5rem">Chúc bạn may mắn lần sau! Bạn đã hết lượt quay cho chiến dịch này.</p>
        <button class="btn btn-secondary" data-goto="phone">Quay lại</button>
      </section>
    </div>

    <div class="mock-banner"><strong>MOCK ONLY</strong> — No backend. Preview UI before implementation.</div>

    <script is:inline>
      const SLOTS = [
        { sub: "Giảm", main: "10%", icon: "🏷️", color: "#016D3B", textColor: "#FFFFFF", bg: "rgba(0,0,0,0.2)" },
        { single: "Thử lại", icon: "🍃", color: "#7A8E7B", textColor: "#FFFFFF", bg: "rgba(0,0,0,0.16)" },
        { sub: "Latte", main: "Free", icon: "☕", color: "#2F8F63", textColor: "#FFFFFF", bg: "rgba(0,0,0,0.18)" },
        { single: "Thử lại", icon: "🔄", color: "#C5D9C8", textColor: "#1F2D24", bg: "rgba(255,255,255,0.5)", stroke: "rgba(31,45,36,0.1)" },
        { sub: "Giảm", main: "20%", icon: "🎁", color: "#014A29", textColor: "#FFFFFF", bg: "rgba(0,0,0,0.22)" },
        { sub: "Mochi", main: "Free", icon: "🍡", color: "#4DB779", textColor: "#FFFFFF", bg: "rgba(0,0,0,0.16)" },
      ];

      function buildSlotLabel(slot, shadowFilter) {
        const stroke = slot.stroke || "rgba(255,255,255,0.18)";

        if (slot.single) {
          const bgW = 30;
          const bgH = 22;
          return `
            <rect class="wheel-label-bg" x="${-bgW / 2}" y="${-bgH / 2}" width="${bgW}" height="${bgH}" rx="6"
              fill="${slot.bg}" stroke="${stroke}" />
            <text font-size="11" y="-3">${slot.icon}</text>
            <text font-size="5.5" font-weight="700" y="7" fill="${slot.textColor}" filter="${shadowFilter}"
              text-anchor="middle">${slot.single}</text>`;
        }

        const bgW = 32;
        const bgH = 24;
        return `
          <rect class="wheel-label-bg" x="${-bgW / 2}" y="${-bgH / 2}" width="${bgW}" height="${bgH}" rx="6"
            fill="${slot.bg}" stroke="${stroke}" />
          <text font-size="11" y="-4">${slot.icon}</text>
          <text font-size="4.5" font-weight="600" y="2" fill="${slot.textColor}" filter="${shadowFilter}"
            text-anchor="middle" letter-spacing="0.06em">${slot.sub.toUpperCase()}</text>
          <text font-size="6.5" font-weight="800" y="9" fill="${slot.textColor}" filter="${shadowFilter}"
            text-anchor="middle">${slot.main}</text>`;
      }

      const screens = {
        phone: document.getElementById("screen-phone"),
        wheel: document.getElementById("screen-wheel"),
        win: document.getElementById("screen-win"),
        lose: document.getElementById("screen-lose"),
      };

      const wheelEl = document.getElementById("wheel");
      const wheelSvg = document.getElementById("wheel-svg");
      let currentRotation = 0;

      function buildWheel() {
        const n = SLOTS.length;
        const slice = 360 / n;
        let svgContent = `
          <defs>
            <clipPath id="wheel-clip">
              <circle cx="0" cy="0" r="100" />
            </clipPath>
            <filter id="wheel-text-shadow" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="1" stdDeviation="1.4" flood-color="#000000" flood-opacity="0.35"/>
            </filter>
            <filter id="wheel-text-shadow-soft" x="-30%" y="-30%" width="160%" height="160%">
              <feDropShadow dx="0" dy="0.5" stdDeviation="0.8" flood-color="#000000" flood-opacity="0.2"/>
            </filter>
          </defs>
          <g clip-path="url(#wheel-clip)">`;

        SLOTS.forEach((slot, i) => {
          const start = (i * slice - 90) * (Math.PI / 180);
          const end = ((i + 1) * slice - 90) * (Math.PI / 180);
          const x1 = 100 * Math.cos(start);
          const y1 = 100 * Math.sin(start);
          const x2 = 100 * Math.cos(end);
          const y2 = 100 * Math.sin(end);
          const large = slice > 180 ? 1 : 0;

          svgContent += `<path class="wheel-segment" d="M 0 0 L ${x1} ${y1} A 100 100 0 ${large} 1 ${x2} ${y2} Z" fill="${slot.color}" />`;
        });

        svgContent += `</g>`;

        SLOTS.forEach((slot, i) => {
          const bisector = i * slice + slice / 2;
          const angleRad = (bisector - 90) * (Math.PI / 180);
          const dist = 64;
          const cx = dist * Math.cos(angleRad);
          const cy = dist * Math.sin(angleRad);

          // Align label with wedge bisector; flip bottom half for readability
          let textRot = bisector - 90;
          if (bisector > 90 && bisector < 270) {
            textRot += 180;
          }

          const shadowFilter = slot.textColor === "#1F2D24"
            ? "url(#wheel-text-shadow-soft)"
            : "url(#wheel-text-shadow)";
          const label = buildSlotLabel(slot, shadowFilter);

          svgContent += `
            <g transform="translate(${cx.toFixed(2)}, ${cy.toFixed(2)}) rotate(${textRot.toFixed(2)})">
              ${label}
            </g>`;
        });

        wheelSvg.innerHTML = svgContent;
      }

      function showScreen(name) {
        Object.entries(screens).forEach(([key, el]) => {
          el.classList.toggle("active", key === name);
        });
        document.querySelectorAll(".state-tab").forEach((tab) => {
          tab.classList.toggle("active", tab.dataset.goto === name);
        });
      }

      function spinToIndex(index, onDone) {
        const n = SLOTS.length;
        const slice = 360 / n;
        const target = 360 - (index * slice + slice / 2);
        const spins = 5 * 360;
        currentRotation += spins + target - (currentRotation % 360);
        wheelEl.style.transform = `rotate(${currentRotation}deg)`;
        setTimeout(onDone, 4200);
      }

      document.getElementById("btn-spin").addEventListener("click", () => {
        const phone = document.getElementById("phone").value.replace(/\D/g, "");
        if (phone.length !== 10) {
          alert("Vui lòng nhập đúng 10 chữ số.");
          return;
        }
        showScreen("wheel");
        // Mock: land on "10% Off" (index 0) or random lose
        const winIndex = Math.random() > 0.35 ? 0 : 1;
        spinToIndex(winIndex, () => {
          showScreen(winIndex === 0 ? "win" : "lose");
        });
      });

      document.getElementById("btn-lookup").addEventListener("click", () => {
        showScreen("win");
      });

      document.querySelectorAll("[data-goto]").forEach((el) => {
        el.addEventListener("click", () => showScreen(el.dataset.goto));
      });

      buildWheel();
    </script>
  </body>
</html>
