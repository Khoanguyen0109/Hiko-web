---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.png';
import features from '@data/features.json';
import pricing from '@data/pricing.json';
import storefrontMain from '@images/store/storefront-main.png';
import interiorWindow from '@images/store/interior-window.png';
import welcomeSign from '@images/store/welcome-sign.png';
import entranceCheer from '@images/store/entrance-cheer.png';
import seatingArea from '@images/store/seating-area.png';
import storefrontPlants from '@images/store/storefront-plants.png';
import construction from '@images/construction-image.avif';
import tools from '@images/using-tools.png';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Đặt hàng qua GrabFood"
    url="https://food.grab.com/vn/vi/restaurant/hiko-matcha-delivery/5-C7NHN6CWJPBTAA"
  />

  <HeroSection
    title=`100% Matcha Nhật — <span class="text-yellow-500 dark:text-yellow-400">Đậm vị nguyên bản</span>`
    subTitle="Matcha Coco, Cold Whisk, fruit lattes — thưởng thức tại 2 cửa hàng ở Tân Bình & Gò Vấp, hoặc đặt qua GrabFood."
    primaryBtn="Xem Menu"
    primaryBtnURL="/products"
    secondaryBtn="Đặt Grab Ngay"
    secondaryBtnURL="https://food.grab.com/vn/vi/restaurant/hiko-matcha-delivery/5-C7NHN6CWJPBTAA"
    withReview={false}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">5.0</span> / 5`
    starCount={5}
    reviews=`Từ khách hàng trên <span class="font-bold">Google Maps</span>`
    src={heroImage}
    alt="Banner khuyến mãi mùa hè Hiko Matcha — các ly matcha đa dạng"
  />

  <ClientsSection
    title="Có Mặt Trên"
    subTitle="Đặt hàng Hiko Matcha trên các nền tảng yêu thích của bạn."
    partners={partnersData}
  />

  <FeaturesGeneral
    title="Tại Sao Chọn Hiko Matcha?"
    subTitle="Chúng tôi mang đến trải nghiệm matcha tươi nguyên chất, pha theo từng đơn, giao tận nơi hoặc thưởng thức tại cửa hàng."
    images={[
      {
        src: storefrontPlants,
        alt: 'Mặt tiền Hiko Matcha với cây xanh và ghế ngồi ngoài trời',
        class:
          'inset-0 z-0 h-[72%] w-[88%] left-[6%] top-[8%] md:h-[78%] md:w-[72%] md:left-[14%]',
      },
      {
        src: interiorWindow,
        alt: 'Không gian trong quán — cửa kính và cây xanh',
        class:
          'bottom-0 left-0 z-20 h-[48%] w-[46%] md:h-[52%] md:w-[34%] -translate-x-1 translate-y-2 md:translate-x-0',
      },
      {
        src: welcomeSign,
        alt: 'Bảng welcome Hiko House trang trí tại cửa hàng',
        class:
          'right-0 top-0 z-30 h-[44%] w-[40%] md:h-[48%] md:w-[28%] rotate-2',
      },
      {
        src: entranceCheer,
        alt: 'Cổng vào Hiko Matcha — Dine in & Take away',
        class:
          'bottom-2 right-[8%] z-20 h-[38%] w-[36%] md:bottom-4 md:right-[18%] md:h-[42%] md:w-[26%] -rotate-1',
      },
      {
        src: seatingArea,
        alt: 'Khu vực ngồi chill trong quán Hiko Matcha',
        class:
          'left-[28%] top-[4%] z-10 hidden h-[36%] w-[32%] sm:block md:left-[38%] md:h-[38%] md:w-[22%]',
      },
      {
        src: storefrontMain,
        alt: 'Hiko Matcha — Chill, Sip, Vibe',
        class:
          'bottom-0 right-0 z-10 h-[32%] w-[34%] md:h-[36%] md:w-[24%] translate-x-1 translate-y-1',
      },
    ]}
    features={features}
  />

  <FeaturesNavs
    title=`Khám phá thế giới matcha của <span class="text-yellow-500 dark:text-yellow-400">Hiko Matcha</span>`
    tabs={[
      {
        heading: 'Matcha Đậm Vị',
        content:
          'Những ly matcha nguyên chất được pha đậm đà, giữ nguyên vị đắng nhẹ đặc trưng. Phù hợp cho người yêu thích matcha thuần túy.',
        svg: 'matcha',
        src: tools,
        alt: 'Matcha CoCo — signature drink Hiko Matcha',
        first: true,
      },
      {
        heading: 'Matcha Trái Cây',
        content:
          'Sự kết hợp sáng tạo giữa matcha và trái cây tươi — Xoài, Dâu, Kiwi, Sakura. Vừa thơm vừa mát, lý tưởng cho ngày nắng.',
        svg: 'fruit',
        src: dashboard,
        alt: 'Ly Matcha Trái Cây Hiko Matcha',
        second: true,
      },
      {
        heading: 'Cacao & Cafe',
        content:
          'Không chỉ matcha — Hiko cũng phục vụ cacao và cafe cho những ai muốn thay đổi khẩu vị nhưng vẫn tìm kiếm chất lượng cao.',
        svg: 'coffee',
        src: construction,
        alt: 'Cacao và Cafe tại Hiko Matcha',
      },
    ]}
  />

  <TestimonialsSection
    title="Khách Hàng Nói Gì?"
    subTitle="Hiko Matcha tự hào phục vụ hàng trăm khách hàng mỗi ngày tại Tân Bình và Gò Vấp."
    testimonials={[
      {
        content:
          'Quán mới mở, matcha pha ngon, mình thích latte, vị dâu rất oke nha 🫶 Không gian quán phòng lạnh vừa đủ tầm 7 bàn, nhưng phía trước rộng, tối chill chill rất oke đó hi',
        author: 'Khách hàng Google Maps',
        role: '⭐⭐⭐⭐⭐ · Hiko Matcha',
        avatarSrc:
          'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
      },
      {
        content:
          'Quán thơm, bước vào sẽ nghe được mùi tinh dầu thoang thoảng. Nên uống thử matcha — không có bị đắng lắm, dễ uống, người uống không quen có thể uống được.',
        author: 'Khách hàng Google Maps',
        role: '⭐⭐⭐⭐⭐ · Hiko Matcha',
        avatarSrc:
          'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
      },
      {
        content:
          'Không gian chữa lành lắm mọi người ơi, sáng trưa chiều tối mà rủ bạn bè qua đây chơi hay chạy deadline gì cũng hết sẩy.',
        author: 'Khách hàng Google Maps',
        role: '⭐⭐⭐⭐⭐ · Hiko Matcha',
        avatarSrc:
          'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
      },
      {
        content:
          'Không gian quán yên tĩnh, thích hợp cho việc học tập và làm việc. Quán mở nhạc chill chill. Nói chung oke.',
        author: 'Khách hàng Google Maps',
        role: '⭐⭐⭐⭐⭐ · Hiko Matcha',
        avatarSrc:
          'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
      },
    ]}
    statistics={[
      {
        count: '2',
        description: 'cửa hàng tại Tân Bình & Gò Vấp, TP.HCM',
      },
      {
        count: '5+',
        description: 'dòng sản phẩm matcha, cacao và cafe đặc sắc',
      },
      {
        count: '~53k',
        description: 'VND mỗi ly — chất lượng cao, giá hợp lý',
      },
      {
        count: '06:30',
        description: 'mở cửa mỗi ngày, phục vụ từ sáng sớm đến 22:15',
      },
    ]}
  />

  <PricingSection pricing={pricing} />

</MainLayout>
