# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=you@example.com

# Sender address (must be a verified domain in Resend)
# For testing, use: Hiko Matcha <onboarding@resend.dev>
RESEND_FROM=Hiko Matcha <hello@hikomatcha.vn>

# Hiko POS backend API (server-side proxy for spin game)
HIKO_POS_API_URL=http://localhost:3000/api

# Same value as pos-backend HIKO_ORDER_KEY. Server-side only.
HIKO_ORDER_KEY=
